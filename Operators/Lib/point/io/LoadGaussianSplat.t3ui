{
  "FormatVersion": 3,
  "Id": "740960bb-9029-463f-9543-fda43e48ff17"/*LoadGaussianSplat*/,
  "Description": "Loads a Nerfstudio Gaussian Splat PLY as a TiXL point buffer.\n\nThe loader supports the binary little-endian Nerfstudio 1.1.5 vertex layout and maps position, rotation, scale, opacity, and DC color coefficients to TiXL Point attributes. It preserves the source coordinate system and ignores view-dependent SH coefficients for this MVP.\n\n[DrawPoints] or [DrawBillboards] can be used to preview the loaded points.",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "5cc67374-1114-48f6-be01-b2edb4770b55"/*Path*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "File",
      "Description": "The Nerfstudio Gaussian Splat PLY file to load.",
      "Usage": "FilePath",
      "FileFilter": "ply"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "14e4a7de-13ce-49bb-95c9-91db0058872e"/*PointBuffer*/,
      "Position": {
        "X": 120.0,
        "Y": 0.0
      }
    }
  ]
}